# Neon Dugout — Production Environment Variables
# Copy this file to .env.production and fill in the values

# Database (auto-filled by deploy.sh)
DATABASE_URL=postgresql://neondugout:CHANGE_THIS_PASSWORD@localhost:5432/neondugout

# App
NODE_ENV=production
PORT=5000

# Auth (auto-generated by deploy.sh)
JWT_SECRET=CHANGE_THIS_SECRET

# Solana (required — fill in your values)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
MERCHANT_WALLET=YOUR_SOLANA_WALLET_PUBLIC_KEY
